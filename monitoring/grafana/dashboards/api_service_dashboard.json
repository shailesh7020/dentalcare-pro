{
  "title": "DentalCare Pro - API Performance & Latency Telemetry",
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "5s",
  "panels": [
    {
      "title": "API Request Rate by Status Code",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(dentalcare_http_requests_total[1m])) by (status)"}]
    },
    {
      "title": "Latency Percentiles (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum(rate(dentalcare_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, sum(rate(dentalcare_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, sum(rate(dentalcare_http_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "P99"}
      ]
    }
  ]
}